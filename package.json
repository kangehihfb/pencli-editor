{
  "name": "webgl-r3f-editor-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:realtime": "yarn --cwd ../../../mildang-backend-study-activity/mildang-backend-handwriting start:dev",
    "dev:signoz": "bash scripts/dev-signoz.sh up",
    "dev:signoz:down": "bash scripts/dev-signoz.sh down",
    "dev:signoz:reset": "bash scripts/dev-signoz.sh down:volumes",
    "build": "vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "export:browser-screenshot": "node scripts/utils/export-browser-screenshot.mjs",
    "test:pencil-input": "node scripts/utils/pencil-input-compat-report.mjs",
    "load:realtime-fleet": "node scripts/load/realtime-fleet.mjs",
    "load:realtime-socket": "npx artillery run load-tests/artillery/realtime-socket.yml",
    "load:realtime-socket:check": "npx prettier --check load-tests/artillery/realtime-socket.yml",
    "load:realtime-socket:smoke": "npx artillery run --solo load-tests/artillery/realtime-socket-smoke.yml",
    "load:realtime-socket:debug": "node scripts/load/realtime-socket-load.mjs",
    "analyze:realtime-fleet": "node scripts/analysis/analyze-realtime-fleet.mjs",
    "load:artillery": "npm run load:realtime-socket",
    "load:artillery:check": "npm run load:realtime-socket:check",
    "load:artillery:smoke": "npm run load:realtime-socket:smoke",
    "load:k6": "k6 run load-tests/k6/handwriting-api.js",
    "test:e2e": "npx playwright test --config load-tests/playwright-tests/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --config load-tests/playwright-tests/playwright.config.ts --headed",
    "test:e2e:report": "npx playwright show-report export-results/playwright-e2e-report",
    "test:room-pairs": "npx playwright test --config load-tests/playwright-tests/playwright.room-pairs.config.ts",
    "test:room-pairs:100": "TEST_STACK=${TEST_STACK:-socketio-yjs} TEST_SCENARIO=${TEST_SCENARIO:-room-pairs-100} ROOM_PAIR_ROOMS=${ROOM_PAIR_ROOMS:-100} ROOM_PAIR_USERS_PER_ROOM=${ROOM_PAIR_USERS_PER_ROOM:-2} ROOM_PAIR_CONCURRENCY=${ROOM_PAIR_CONCURRENCY:-50} ROOM_PAIR_STARTUP_TIMEOUT_MS=${ROOM_PAIR_STARTUP_TIMEOUT_MS:-60000} ROOM_PAIR_REALTIME_TIMEOUT_MS=${ROOM_PAIR_REALTIME_TIMEOUT_MS:-60000} ROOM_PAIR_SYNC_TIMEOUT_MS=${ROOM_PAIR_SYNC_TIMEOUT_MS:-30000} ROOM_PAIR_RUN_TIMEOUT_MS=${ROOM_PAIR_RUN_TIMEOUT_MS:-0} ROOM_PAIR_TEST_TIMEOUT_MS=${ROOM_PAIR_TEST_TIMEOUT_MS:-0} ROOM_PAIR_STRICT_ASSERTIONS=${ROOM_PAIR_STRICT_ASSERTIONS:-0} npm run test:room-pairs",
    "test:room-pairs:100:burst": "TEST_STACK=${TEST_STACK:-socketio-yjs} TEST_SCENARIO=${TEST_SCENARIO:-room-pairs-100-burst} ROOM_PAIR_ROOMS=${ROOM_PAIR_ROOMS:-100} ROOM_PAIR_USERS_PER_ROOM=${ROOM_PAIR_USERS_PER_ROOM:-2} ROOM_PAIR_CONCURRENCY=${ROOM_PAIR_CONCURRENCY:-100} ROOM_PAIR_STARTUP_TIMEOUT_MS=${ROOM_PAIR_STARTUP_TIMEOUT_MS:-60000} ROOM_PAIR_REALTIME_TIMEOUT_MS=${ROOM_PAIR_REALTIME_TIMEOUT_MS:-60000} ROOM_PAIR_SYNC_TIMEOUT_MS=${ROOM_PAIR_SYNC_TIMEOUT_MS:-30000} ROOM_PAIR_RUN_TIMEOUT_MS=${ROOM_PAIR_RUN_TIMEOUT_MS:-60000} ROOM_PAIR_STRICT_ASSERTIONS=${ROOM_PAIR_STRICT_ASSERTIONS:-1} npm run test:room-pairs",
    "test:room-pairs:200": "TEST_STACK=${TEST_STACK:-socketio-yjs} TEST_SCENARIO=${TEST_SCENARIO:-room-pairs-200} ROOM_PAIR_ROOMS=${ROOM_PAIR_ROOMS:-200} ROOM_PAIR_USERS_PER_ROOM=${ROOM_PAIR_USERS_PER_ROOM:-2} ROOM_PAIR_CONCURRENCY=${ROOM_PAIR_CONCURRENCY:-50} ROOM_PAIR_STARTUP_TIMEOUT_MS=${ROOM_PAIR_STARTUP_TIMEOUT_MS:-60000} ROOM_PAIR_REALTIME_TIMEOUT_MS=${ROOM_PAIR_REALTIME_TIMEOUT_MS:-60000} ROOM_PAIR_SYNC_TIMEOUT_MS=${ROOM_PAIR_SYNC_TIMEOUT_MS:-30000} ROOM_PAIR_RUN_TIMEOUT_MS=${ROOM_PAIR_RUN_TIMEOUT_MS:-0} ROOM_PAIR_TEST_TIMEOUT_MS=${ROOM_PAIR_TEST_TIMEOUT_MS:-0} ROOM_PAIR_STRICT_ASSERTIONS=${ROOM_PAIR_STRICT_ASSERTIONS:-0} npm run test:room-pairs",
    "test:room-pairs:200:burst": "TEST_STACK=${TEST_STACK:-socketio-yjs} TEST_SCENARIO=${TEST_SCENARIO:-room-pairs-200-burst} ROOM_PAIR_ROOMS=${ROOM_PAIR_ROOMS:-200} ROOM_PAIR_USERS_PER_ROOM=${ROOM_PAIR_USERS_PER_ROOM:-2} ROOM_PAIR_CONCURRENCY=${ROOM_PAIR_CONCURRENCY:-100} ROOM_PAIR_STARTUP_TIMEOUT_MS=${ROOM_PAIR_STARTUP_TIMEOUT_MS:-60000} ROOM_PAIR_REALTIME_TIMEOUT_MS=${ROOM_PAIR_REALTIME_TIMEOUT_MS:-60000} ROOM_PAIR_SYNC_TIMEOUT_MS=${ROOM_PAIR_SYNC_TIMEOUT_MS:-30000} ROOM_PAIR_RUN_TIMEOUT_MS=${ROOM_PAIR_RUN_TIMEOUT_MS:-120000} ROOM_PAIR_STRICT_ASSERTIONS=${ROOM_PAIR_STRICT_ASSERTIONS:-1} npm run test:room-pairs",
    "test:room-pairs:headed": "ROOM_PAIR_HEADLESS=0 npm run test:room-pairs",
    "test:room-pairs:report": "npx playwright show-report export-results/playwright-room-pairs-report",
    "test:class-session": "npx playwright test --config load-tests/playwright-tests/playwright.class-session.config.ts",
    "test:class-session:smoke": "TEST_STACK=${TEST_STACK:-socketio-yjs} TEST_SCENARIO=${TEST_SCENARIO:-class-session-smoke-1to1} CLASS_SESSION_ROOMS=${CLASS_SESSION_ROOMS:-2} CLASS_SESSION_CONCURRENCY=${CLASS_SESSION_CONCURRENCY:-2} CLASS_SESSION_DURATION_MS=${CLASS_SESSION_DURATION_MS:-30000} CLASS_SESSION_HEARTBEAT_INTERVAL_MS=${CLASS_SESSION_HEARTBEAT_INTERVAL_MS:-10000} CLASS_SESSION_STARTUP_TIMEOUT_MS=${CLASS_SESSION_STARTUP_TIMEOUT_MS:-60000} CLASS_SESSION_REALTIME_TIMEOUT_MS=${CLASS_SESSION_REALTIME_TIMEOUT_MS:-60000} CLASS_SESSION_SYNC_TIMEOUT_MS=${CLASS_SESSION_SYNC_TIMEOUT_MS:-30000} CLASS_SESSION_TEST_TIMEOUT_MS=${CLASS_SESSION_TEST_TIMEOUT_MS:-0} CLASS_SESSION_STRICT_ASSERTIONS=${CLASS_SESSION_STRICT_ASSERTIONS:-1} npm run test:class-session",
    "test:class-session:10m": "TEST_STACK=${TEST_STACK:-socketio-yjs} TEST_SCENARIO=${TEST_SCENARIO:-class-session-10m} CLASS_SESSION_ROOMS=${CLASS_SESSION_ROOMS:-10} CLASS_SESSION_TOTAL_ROOMS=${CLASS_SESSION_TOTAL_ROOMS:-10} CLASS_SESSION_CONCURRENCY=${CLASS_SESSION_CONCURRENCY:-10} CLASS_SESSION_HEARTBEAT_CONCURRENCY=${CLASS_SESSION_HEARTBEAT_CONCURRENCY:-10} CLASS_SESSION_DURATION_MS=${CLASS_SESSION_DURATION_MS:-600000} CLASS_SESSION_HEARTBEAT_INTERVAL_MS=${CLASS_SESSION_HEARTBEAT_INTERVAL_MS:-60000} CLASS_SESSION_SYNC_TIMEOUT_MS=${CLASS_SESSION_SYNC_TIMEOUT_MS:-10000} CLASS_SESSION_SYNC_P95_SLA_MS=${CLASS_SESSION_SYNC_P95_SLA_MS:-1000} CLASS_SESSION_TEST_TIMEOUT_MS=${CLASS_SESSION_TEST_TIMEOUT_MS:-0} npm run test:class-session",
    "test:class-session:1h": "TEST_STACK=${TEST_STACK:-socketio-yjs} TEST_SCENARIO=${TEST_SCENARIO:-class-session-1h-1to1} CLASS_SESSION_ROOMS=${CLASS_SESSION_ROOMS:-100} CLASS_SESSION_CONCURRENCY=${CLASS_SESSION_CONCURRENCY:-25} CLASS_SESSION_HEARTBEAT_CONCURRENCY=${CLASS_SESSION_HEARTBEAT_CONCURRENCY:-25} CLASS_SESSION_DURATION_MS=${CLASS_SESSION_DURATION_MS:-3600000} CLASS_SESSION_HEARTBEAT_INTERVAL_MS=${CLASS_SESSION_HEARTBEAT_INTERVAL_MS:-300000} CLASS_SESSION_STARTUP_TIMEOUT_MS=${CLASS_SESSION_STARTUP_TIMEOUT_MS:-60000} CLASS_SESSION_REALTIME_TIMEOUT_MS=${CLASS_SESSION_REALTIME_TIMEOUT_MS:-60000} CLASS_SESSION_SYNC_TIMEOUT_MS=${CLASS_SESSION_SYNC_TIMEOUT_MS:-30000} CLASS_SESSION_TEST_TIMEOUT_MS=${CLASS_SESSION_TEST_TIMEOUT_MS:-0} CLASS_SESSION_STRICT_ASSERTIONS=${CLASS_SESSION_STRICT_ASSERTIONS:-1} npm run test:class-session",
    "test:class-session:report": "npx playwright show-report export-results/playwright-class-session-report",
    "preview": "vite preview"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-web": "^0.63.0",
    "@opentelemetry/context-zone": "^2.7.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "clipper-lib": "^6.4.2",
    "engine.io-parser": "^5.2.3",
    "leva": "^0.10.0",
    "lucide-react": "^0.468.0",
    "modern-screenshot": "^4.7.0",
    "perfect-freehand": "^1.2.3",
    "pretendard": "^1.3.9",
    "r3f-perf": "^7.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3",
    "socket.io-parser": "^4.2.6",
    "three": "^0.171.0",
    "ws": "^8.18.3",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "artillery": "^2.0.31",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^48.0.1",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
