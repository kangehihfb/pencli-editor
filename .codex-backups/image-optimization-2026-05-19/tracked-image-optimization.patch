+  span.setAttribute("traceparent", traceCarrier.traceparent ?? "");
+
+  try {
+    const response = await fetch(url, {
+      method: "POST",
+      headers: {
+        "content-type": input.file.type || "application/octet-stream",
+        "x-file-name": input.file.name,
+        ...traceCarrier,
